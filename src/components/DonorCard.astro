---
// Directory card: a thin band tinted in the type colour carries the type badge and the application status;
// then the logo plate centred over the name, a two-line summary, three key facts and the field chips.
// The third fact is the grant size when the report gives one; otherwise (most cards) the grant types,
// so the slot tells cards apart instead of repeating "غير معلن".
import type { CollectionEntry } from 'astro:content';
import Tile from './Tile.astro';
import TypeChip from './TypeChip.astro';
import { ACC, TYPE, codeOf, cycleShort, reachShort, sizeShort, grantRange, withBase } from '../lib/donors';
import { normalizeAr } from '../lib/arabic';
interface Props { entry: CollectionEntry<'donors'> }
const { entry } = Astro.props;
const d = entry.data;
const t = TYPE[d.type] ?? TYPE.other;
const quick = normalizeAr([d.name, d.hq, d.scope, d.legalForm, TYPE[d.type]?.label, ...d.fields, ...d.regions, ...d.grantTypes].join(' '));
const size = sizeShort(d);
const reach = reachShort(d);
const gt = d.grantTypes.length ? d.grantTypes[0] + (d.grantTypes.length > 1 ? ` +${d.grantTypes.length - 1}` : '') : '';
---
<article class="card" data-card
   data-id={entry.id} data-code={d.code} data-name={d.name} data-type={d.type} data-access={d.access}
   data-max={d.maxGrant ?? 0} data-fields={d.fields.join('|')} data-regions={d.regions.join('|')}
   data-gtypes={d.grantTypes.join('|')} data-quick={quick}>
  <div class="cband" style={`--tc:var(${t.color})`}>
    <TypeChip type={d.type} />
    <span class:list={['st', d.access]}><span class="dot" aria-hidden="true"></span>{ACC[d.access]}</span>
  </div>
  <div class="body">
    <div class="head">
      <Tile name={d.name} type={d.type} logo={d.logo} id={entry.id} size="md" />
      <div class="t">
        <h3><a class="stretch" href={withBase(`donors/${entry.id}/`)}><span class="nm">{d.name}</span></a></h3>
        <div class="sub"><span class="code mono" translate="no">{codeOf(d.code)}</span>{d.hq && <span class="hq">· {d.hq}</span>}</div>
      </div>
    </div>
    <p class="sum">{d.summary || d.mission}</p>
  </div>
  <ul class="kf">
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></svg>
      <span class="l">الدورة</span><span class="v" title={d.cycle}>{cycleShort(d.cycle)}</span></li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
      <span class="l">النطاق</span><span class="v" title={d.regions.join('، ') || d.scope}>{reach}</span></li>
    {size || !gt
      ? <li><svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" /><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" /></svg>
          <span class="l">الحجم</span><span class:list={['v', 'num', !size && 'none']} title={grantRange(d)}>{size || 'غير معلن'}</span></li>
      : <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9z" /><circle cx="8" cy="8" r="1.6" /></svg>
          <span class="l">نوع المنحة</span><span class="v" title={d.grantTypes.join('، ')}>{gt}</span></li>}
  </ul>
  <div class="cfoot">
    <div class="chips">
      {d.fields.map((x) => <span class="chip" title={x}>{x}</span>)}
      <span class="chip more" hidden></span>
    </div>
    <label class="cmpbox" title="أضف للمقارنة">
      <input type="checkbox" data-cmp={entry.id} aria-label={`أضف ${d.name} للمقارنة`} />
      <svg class="i-add" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3" /><path d="M16 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3" /><path d="M12 8v8M8 12h8" /></svg>
      <svg class="i-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3" /><path d="M16 3h3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-3" /><path d="M8.5 12.5l2.5 2.5 4.5-5" /></svg>
    </label>
  </div>
</article>
