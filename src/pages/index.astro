---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DonorCard from '../components/DonorCard.astro';
import { TYPES, ACCESS, GTYPES, REGIONS, withBase } from '../lib/donors';
const entries = (await getCollection('donors')).sort((a, b) => a.data.code - b.data.code);
const L = entries.map((e) => e.data);
const n = L.length;
const c = (t: string) => L.filter((d) => d.type === t).length;
const open = L.filter((d) => d.access === 'open' || d.access === 'mixed').length;
const fieldCount: Record<string, number> = {};
L.forEach((d) => d.fields.forEach((f) => (fieldCount[f] = (fieldCount[f] || 0) + 1)));
const topFields = Object.entries(fieldCount).sort((a, b) => b[1] - a[1]).slice(0, 9);
const maxF = topFields[0]?.[1] || 1;
const stats: [string | number, string, string?][] = [
  [n, 'جهة مانحة في الدليل'],
  [c('waqf'), 'وقف', '--t-waqf'],
  [c('found'), 'مؤسسة مانحة', '--t-found'],
  [c('gov'), 'جهة حكومية', '--t-gov'],
  [c('csr') + c('fund') + c('other'), 'شركات وصناديق وغيرها', '--t-csr'],
  [n ? Math.round((open / n) * 100) + '%' : '—', 'تتيح التقديم المفتوح'],
  [Object.keys(fieldCount).length, 'مجالاً مغطى'],
];
---
<Base nav="directory">
  <div class="brand" slot="hero">
    <h1>استكشف الجهات المانحة</h1>
    <p>أوقاف ومؤسسات مانحة وجهات حكومية وبرامج مسؤولية اجتماعية، درسها طلاب الدفعة على محاور بطاقة الدراسة.</p>
  </div>

  <div class="stats">
    {stats.map(([v, l, col]) => (
      <div class="stat"><div class="v">{v}</div><div class="l">{col && <span class="dot" style={`background:var(${col})`} />}{l}</div></div>
    ))}
  </div>

  <div class="dir" style="padding-bottom:64px">
    <aside class="rail" id="rail">
      <div>
        <label for="q">بحث</label>
        <input class="field search" id="q" type="search" placeholder="اسم الجهة، مدينة، مجال، شرط…" autocomplete="off" />
      </div>
      <button class="btn filters-mobile" id="toggleFilters" type="button" aria-expanded="false" aria-controls="rail">التصفية</button>
      <div class="grp"><label for="fType">نوع الجهة</label>
        <select class="field" id="fType" data-f="type"><option value="">كل الأنواع</option>{TYPES.map((t) => <option value={t[0]}>{t[1]}</option>)}</select></div>
      <div class="grp"><label for="fAccess">طريقة التقديم</label>
        <select class="field" id="fAccess" data-f="access"><option value="">الكل</option>{ACCESS.map((t) => <option value={t[0]}>{t[1]}</option>)}</select></div>
      <div class="grp"><label for="fGtype">نوع المنحة</label>
        <select class="field" id="fGtype" data-f="gtype"><option value="">الكل</option>{GTYPES.map((t) => <option value={t}>{t}</option>)}</select></div>
      <div class="grp"><label for="fRegion">المنطقة المستهدفة</label>
        <select class="field" id="fRegion" data-f="region"><option value="">كل المناطق</option>{REGIONS.map((t) => <option value={t}>{t}</option>)}</select></div>
      <div class="grp"><label id="barsLbl">المجالات الأكثر حضوراً</label>
        <div class="bars" role="group" aria-labelledby="barsLbl">
          {topFields.map(([k, v]) => (
            <button type="button" class="bar" data-field={k} aria-pressed="false">
              <span class="track"><span class="fill" style={`width:${Math.max(8, (v / maxF) * 100)}%`} /><span class="name">{k}</span></span><span class="n">{v}</span>
            </button>
          ))}
        </div>
      </div>
    </aside>
    <div style="min-width:0">
      <div class="toolbar">
        <div class="res" id="resCount" aria-live="polite">{n} من {n} جهة</div>
        <div class="chips" id="activeChips"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <select class="field" id="sort" style="width:auto" aria-label="الترتيب">
            <option value="code">ترتيب: رقم البطاقة</option>
            <option value="name">ترتيب: الاسم</option>
            <option value="max">ترتيب: أعلى سقف منحة</option>
          </select>
          <a class="btn" href={withBase('data/donors.csv')} download="دليل-الجهات-المانحة.csv">تنزيل CSV</a>
        </div>
      </div>
      <div class="grid" id="grid">{entries.map((e) => <DonorCard entry={e} />)}</div>
      <div class="more-wrap"><button class="btn" type="button" id="moreBtn" hidden>عرض المزيد</button></div>
      <div class="msg info" id="noRes" hidden>لا توجد جهات تطابق هذه التصفية. جرّب إزالة أحد المرشحات.</div>
    </div>
  </div>
</Base>

<script>
  import { tokens } from '../lib/arabic';
  import { readCmp, toggleCmp, onCmpChange, MAX_CMP } from '../lib/compare-store';
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  type F = { q: string; type: string; access: string; gtype: string; region: string; field: string; sort: string };
  const grid = document.getElementById('grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('[data-card]')];
  const q = document.getElementById('q') as HTMLInputElement;
  const sortSel = document.getElementById('sort') as HTMLSelectElement;
  const selects = [...document.querySelectorAll<HTMLSelectElement>('select[data-f]')];
  const bars = [...document.querySelectorAll<HTMLButtonElement>('.bar')];
  const LABEL: Record<string, string> = {};
  selects.forEach((s) => [...s.options].forEach((o) => (LABEL[s.dataset.f + ':' + o.value] = o.text)));

  // full-text index (normalised) loaded on first search
  let full: Record<string, string> | null = null;
  let loading: Promise<void> | null = null;
  const loadIndex = () => (loading ??= fetch(base + '/data/search-index.json').then((r) => r.json()).then((j) => { full = j; }).catch(() => {}));

  const params = new URLSearchParams(location.search);
  const f: F = { q: params.get('q') || '', type: params.get('type') || '', access: params.get('access') || '', gtype: params.get('gtype') || '', region: params.get('region') || '', field: params.get('field') || '', sort: params.get('sort') || 'code' };
  q.value = f.q; sortSel.value = f.sort;
  selects.forEach((s) => (s.value = (f as any)[s.dataset.f!] || ''));

  const PAGE = 24;
  let limit = PAGE;
  const moreBtn = document.getElementById('moreBtn') as HTMLButtonElement;
  const has = (el: HTMLElement, key: string, v: string) => (el.dataset[key] || '').split('|').includes(v);
  function apply(keepLimit = false) {
    if (!keepLimit) limit = PAGE;
    const toks = tokens(f.q);
    if (toks.length) loadIndex();
    let shown = 0;
    for (const el of cards) {
      const hay = (full?.[el.dataset.id!] ?? '') + ' ' + el.dataset.quick;
      const ok = (!f.type || el.dataset.type === f.type) && (!f.access || el.dataset.access === f.access)
        && (!f.gtype || has(el, 'gtypes', f.gtype))
        && (!f.region || has(el, 'regions', f.region) || has(el, 'regions', 'جميع المناطق'))
        && (!f.field || has(el, 'fields', f.field))
        && toks.every((t) => hay.includes(t));
      el.hidden = !ok; if (ok) shown++;
    }
    const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      code: (a, b) => +a.dataset.code! - +b.dataset.code!,
      name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!, 'ar'),
      max: (a, b) => +b.dataset.max! - +a.dataset.max! || +a.dataset.code! - +b.dataset.code!,
    };
    const sorted = [...cards].sort(by[f.sort] || by.code);
    sorted.forEach((el) => grid.appendChild(el));
    let i = 0;
    for (const el of sorted) { if (el.hidden) continue; if (++i > limit) { el.hidden = true; el.dataset.more = '1'; } else delete el.dataset.more; }
    const left = shown - Math.min(shown, limit);
    moreBtn.hidden = left <= 0;
    moreBtn.textContent = `عرض المزيد · باقي ${left} جهة`;
    document.getElementById('resCount')!.textContent = `${shown} من ${cards.length} جهة` + (left > 0 ? ` · يُعرض ${limit}` : '');
    document.getElementById('noRes')!.hidden = shown > 0;
    bars.forEach((b) => { const on = b.dataset.field === f.field; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    const chips: [string, string][] = [];
    (['type', 'access', 'gtype', 'region'] as const).forEach((k) => { if (f[k]) chips.push([k, LABEL[k + ':' + f[k]] || f[k]]); });
    if (f.field) chips.push(['field', f.field]);
    const box = document.getElementById('activeChips')!;
    box.replaceChildren(...chips.map(([k, v]) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'chip x'; b.dataset.clear = k; b.textContent = v; b.setAttribute('aria-label', 'إزالة مرشح ' + v); return b; }));
    const p = new URLSearchParams();
    (Object.keys(f) as (keyof F)[]).forEach((k) => { if (f[k] && !(k === 'sort' && f[k] === 'code')) p.set(k, f[k]); });
    history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p : ''));
  }
  moreBtn.addEventListener('click', () => {
    const first = grid.querySelector<HTMLElement>('[data-card][data-more]');
    limit += PAGE; apply(true);
    first?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  });
  let t: number | undefined;
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { f.q = q.value; apply(); }, 120); });
  q.addEventListener('focus', () => loadIndex(), { once: true });
  selects.forEach((s) => s.addEventListener('change', () => { (f as any)[s.dataset.f!] = s.value; apply(); }));
  sortSel.addEventListener('change', () => { f.sort = sortSel.value; apply(); });
  bars.forEach((b) => b.addEventListener('click', () => { f.field = f.field === b.dataset.field ? '' : b.dataset.field!; apply(); }));
  document.getElementById('activeChips')!.addEventListener('click', (e) => {
    const k = (e.target as HTMLElement).closest<HTMLElement>('[data-clear]')?.dataset.clear; if (!k) return;
    (f as any)[k] = ''; const s = selects.find((x) => x.dataset.f === k); if (s) s.value = ''; apply();
  });
  const rail = document.getElementById('rail')!, tf = document.getElementById('toggleFilters')!;
  tf.addEventListener('click', () => { const o = rail.classList.toggle('open'); tf.setAttribute('aria-expanded', String(o)); });

  // the whole card opens the donor page (the name link is the keyboard/screen-reader target; its ::after
  // overlay can't cover the card because the name window clips it). Selecting text doesn't navigate.
  grid.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('a,button,label,input,select')) return;
    const a = t.closest('[data-card]')?.querySelector<HTMLAnchorElement>('a.stretch');
    if (!a || getSelection()?.toString()) return;
    if (e.metaKey || e.ctrlKey) window.open(a.href, '_blank', 'noopener'); else location.href = a.href;
  });

  // compare checkboxes
  const boxes = [...document.querySelectorAll<HTMLInputElement>('input[data-cmp]')];
  const syncBoxes = () => { const ids = readCmp(); boxes.forEach((b) => { b.checked = ids.includes(b.dataset.cmp!); b.disabled = !b.checked && ids.length >= MAX_CMP; }); };
  boxes.forEach((b) => b.addEventListener('change', () => { if (!toggleCmp(b.dataset.cmp!)) b.checked = false; }));
  onCmpChange(syncBoxes); syncBoxes();

  // one row of field chips per card: chips that don't fit are folded into "+N"
  function fitChips(card: HTMLElement) {
    const box = card.querySelector<HTMLElement>('.chips'); if (!box) return;
    const chips = [...box.querySelectorAll<HTMLElement>('.chip:not(.more)')];
    const more = box.querySelector<HTMLElement>('.chip.more')!;
    chips.forEach((c) => (c.hidden = false)); more.hidden = true;
    const W = box.clientWidth; if (!W) return;
    const gap = 6, widths = chips.map((c) => c.offsetWidth);
    more.hidden = false; more.textContent = '+' + chips.length; const mw = more.offsetWidth;
    let used = 0, n = 0;
    for (let i = 0; i < chips.length; i++) {
      const rest = chips.length - i - 1;
      const need = used + (n ? gap : 0) + widths[i] + (rest ? gap + mw : 0);
      if (need > W) break;
      used += (n ? gap : 0) + widths[i]; n++;
    }
    chips.forEach((c, i) => (c.hidden = i >= n));
    const hiddenList = chips.slice(n).map((c) => c.textContent);
    more.hidden = !hiddenList.length; more.textContent = '+' + hiddenList.length; more.title = hiddenList.join('، ');
  }
  // long names: how far the name must scroll inside its 2-line window to show the rest (~45px per second)
  function fitName(card: HTMLElement) {
    const h = card.querySelector<HTMLElement>('h3'), nm = h?.querySelector<HTMLElement>('.nm'); if (!h || !nm || !h.clientHeight) return;
    const shift = Math.max(0, nm.scrollHeight - h.clientHeight);
    h.classList.toggle('long', shift > 2);
    h.style.setProperty('--shift', shift + 'px');
    h.style.setProperty('--dur', Math.min(2, Math.max(0.6, shift / 45)).toFixed(2) + 's');
  }
  const fitCard = (c: HTMLElement) => { fitChips(c); fitName(c); };
  const ro = new ResizeObserver((es) => es.forEach((e) => fitCard(e.target.closest('[data-card]') as HTMLElement)));
  cards.forEach((c) => { const b = c.querySelector('.chips'); if (b) ro.observe(b); });
  document.fonts?.ready.then(() => cards.forEach(fitCard));
  // touch screens: show the rest of a long name once, when the card is well inside the viewport
  if (matchMedia('(hover: none)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      const h = (e.target as HTMLElement).querySelector('h3');
      if (!e.isIntersecting || !h?.classList.contains('long')) return;
      h.classList.add('peek'); io.unobserve(e.target);
      h.addEventListener('animationend', () => h.classList.remove('peek'), { once: true });
    }), { threshold: 0.9 });
    cards.forEach((c) => io.observe(c));
  }

  if (f.q) loadIndex().then(apply);
  apply();
</script>
